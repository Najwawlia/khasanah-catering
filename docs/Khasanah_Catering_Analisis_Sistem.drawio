    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n2" value="USERS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2B2119;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="320" height="32" as="geometry"/></mxCell>
<mxCell id="n3" value="PK  id                 BIGINT
    name               VARCHAR(255)
    email              VARCHAR(255) UNIQUE
    email_verified_at  TIMESTAMP NULL
    password           VARCHAR(255)
    phone              VARCHAR(255) NULL
    role               ENUM(&#x27;customer&#x27;,&#x27;admin&#x27;)
    remember_token     VARCHAR(100) NULL
    created_at         TIMESTAMP
    updated_at         TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B2119;fontColor=#2B2119;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="60" y="192" width="320" height="232" as="geometry"/></mxCell>
<mxCell id="n4" value="ORDERS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2B2119;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="620" y="60" width="360" height="32" as="geometry"/></mxCell>
<mxCell id="n5" value="PK  id                 BIGINT
    order_code         VARCHAR(255) UNIQUE
FK  user_id            BIGINT NULL
    customer_name      VARCHAR(255)
    customer_phone     VARCHAR(255)
    customer_email     VARCHAR(255)
    event_date         DATE
    delivery_type      ENUM(&#x27;pickup&#x27;,&#x27;delivery&#x27;)
    shipping_address   TEXT NULL
    special_notes      TEXT NULL
    payment_method     VARCHAR(255)
    payment_type       ENUM(&#x27;full&#x27;,&#x27;dp_50&#x27;)
    total_amount       DECIMAL(12,2)
    dp_amount          DECIMAL(12,2)
    paid_amount        DECIMAL(12,2)
    payment_status     ENUM(&#x27;pending&#x27;,&#x27;dp_paid&#x27;,
                            &#x27;paid&#x27;,&#x27;cancelled&#x27;)
    tracking_status    ENUM(&#x27;booking_received&#x27;,
                     &#x27;payment_verified&#x27;,&#x27;kitchen_prep&#x27;,&#x27;ready&#x27;)
    created_at         TIMESTAMP
    updated_at         TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B2119;fontColor=#2B2119;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="620" y="92" width="360" height="474" as="geometry"/></mxCell>
<mxCell id="n6" value="ORDER_ITEMS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2B2119;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="1160" y="160" width="340" height="32" as="geometry"/></mxCell>
<mxCell id="n7" value="PK  id                 BIGINT
FK  order_id           BIGINT
FK  menu_id            BIGINT NULL
    menu_name          VARCHAR(255)
    price_per_pax      DECIMAL(12,2)
    pax_quantity       INT
    subtotal           DECIMAL(12,2)
    created_at         TIMESTAMP
    updated_at         TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B2119;fontColor=#2B2119;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1160" y="192" width="340" height="210" as="geometry"/></mxCell>
<mxCell id="n8" value="MENUS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2B2119;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="1660" y="60" width="340" height="32" as="geometry"/></mxCell>
<mxCell id="n9" value="PK  id                 BIGINT
    name               VARCHAR(255)
    category           VARCHAR(255)
    description        TEXT
    price_per_pax      DECIMAL(12,2)
    min_pax            INT DEFAULT 30
    image              VARCHAR(255) NULL
    is_available       BOOLEAN DEFAULT TRUE
    is_bestseller      BOOLEAN DEFAULT FALSE
    created_at         TIMESTAMP
    updated_at         TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B2119;fontColor=#2B2119;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1660" y="92" width="340" height="254" as="geometry"/></mxCell>
<mxCell id="n10" value="1      N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8A7C6D;fontColor=#2B2119;fontSize=10;endArrow=ERone;startArrow=ERmany;html=1;strokeColor=#B5502E;fontColor=#963F22;fontStyle=1;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n11" value="1      N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8A7C6D;fontColor=#2B2119;fontSize=10;endArrow=ERone;startArrow=ERmany;html=1;strokeColor=#B5502E;fontColor=#963F22;fontStyle=1;" edge="1" parent="1" source="n4" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n12" value="1      N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8A7C6D;fontColor=#2B2119;fontSize=10;endArrow=ERone;startArrow=ERmany;html=1;strokeColor=#B5502E;fontColor=#963F22;fontStyle=1;" edge="1" parent="1" source="n8" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n13" value="Keterangan:
PK = Primary Key (kunci utama, unik per baris)
FK = Foreign Key (kunci tamu, merujuk ke PK tabel lain)
Relasi USERS -&gt; ORDERS: 1 user dapat memiliki N pesanan (user_id nullable = boleh tanpa akun terdaftar)
Relasi ORDERS -&gt; ORDER_ITEMS: 1 pesanan dapat memiliki N item menu
Relasi MENUS -&gt; ORDER_ITEMS: 1 menu dapat muncul di N item pesanan (menu_id nullable = riwayat tetap tersimpan walau menu dihapus)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7CC;strokeColor=#B38F00;fontColor=#2B2119;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="620" height="110" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
